{
  "schemaVersion": 1,
  "id": "quicksilver",
  "version": "${version}",
  "name": "Quicksilver",
  "description": "An all-in-one optimisation mod, starting with a renderer rewrite. Draws exactly what vanilla draws.",
  "authors": [
    "Andre"
  ],
  "contact": {
    "sources": "https://github.com/meakaandre-tech/Quicksilver"
  },
  "license": "LGPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.meakaandre.quicksilver.Quicksilver"
    ],
    "client": [
      "com.meakaandre.quicksilver.QuicksilverClient",
      "com.meakaandre.quicksilver.phase2.ClientTimes"
    ]
  },
  "mixins": [
    "quicksilver.mixins.json",
    "quicksilver.counters.mixins.json",
    "quicksilver.terrain.mixins.json",
    "quicksilver.mesher.mixins.json",
    "quicksilver.mesherorder.mixins.json",
    "quicksilver.visibility.mixins.json",
    "quicksilver.frapi.mixins.json",
    "quicksilver.animation.mixins.json",
    "quicksilver.phase2.mixins.json",
    "quicksilver.memory.mixins.json"
  ],
  "custom": {
    "fabric-renderer-api-v1:contains_renderer": true
  },
  "breaks": {
    "sodium": "*"
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=26.3- <26.4-",
    "java": ">=25",
    "fabric-api": "*"
  }
}
