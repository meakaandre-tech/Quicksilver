{
  "suite": "far",
  "requiresMod": null,
  "ciOwnCheck": "ci/far-compare.py",
  "description": "Package 12: far terrain on worlds CI's core suite doesn't have: Terralith's overworld (run far-terralith: a fresh world with Terralith on the server) and a superflat world (run far-flat: no noise-based generator, so far terrain comes from real chunks only). Quicksilver on the server and the client in both; seed 12345. Far shots against stored Quicksilver references (ci/references/far, ci/far-limits.json). Package 12c: more worlds (Amplified, Large Biomes, the Nullscape data pack with its custom End biomes, three more seeds among them), the cliff seam (east view) against real terrain at render distance 12, the conditions (sunset, night, rain, thunder, pixel art, dynamic lights), the report's views, a server without Quicksilver and the seen-chunks cache across a relog, a 10-minute flight (memory, no stalls), a 10,000-block teleport, the nether and back, and the disk cache across a relog.",
  "preamble": [
    "gamerule advance_time false",
    "gamerule advance_weather false",
    "gamerule send_command_feedback false",
    "gamerule spawn_wandering_traders false",
    "gamemode spectator @a",
    "time set 6000",
    "weather clear"
  ],
  "scenes": [
    {
      "id": "far_land",
      "title": "Terralith's overworld from 230 high above the world's centre, looking down at 35 degrees to the north-west so real terrain, the ocean far below (sections vanilla doesn't hand over: far terrain fills them) and the band show: far terrain off, on, and its hand-over band marked",
      "renderDistance": 8,
      "settleSeconds": 20,
      "ciSkipRuns": [
        "far-flat",
        "far-default",
        "far-vanilla",
        "far-amplified",
        "far-largebiomes",
        "far-nullscape",
        "far-flight"
      ],
      "ciSkipReason": "the Terralith run's scene",
      "setup": [
        "execute in minecraft:overworld run tp @a 0.5 230 0.5 135 35"
      ],
      "ciNoteWait": "a fresh Terralith world: the server is still generating the chunks around the camera for a while after the first tp (run 45863980548 shot them half loaded: a hole where neither real chunks nor far terrain draw, as in vanilla while loading), so the steps wait 60 s first",
      "ciFarSteps": [
        "execute in minecraft:overworld run tp @a 0.5 230 0.5 135 35",
        "#wait 60",
        "#client quicksilver far status",
        "#shot far_off",
        "#far 96",
        "#shot far",
        "#client quicksilver far status",
        "#mark on",
        "#shot far_mark",
        "#mark off",
        "#probe 900 0",
        "#probe 30 0",
        "#probe 60 0",
        "#probe 90 0",
        "#probe 60 30",
        "time set 12700",
        "#wait 4",
        "#shot sunset",
        "time set 18000",
        "#wait 4",
        "#shot night",
        "time set 6000",
        "weather rain",
        "#wait 12",
        "#shot rain",
        "weather thunder",
        "#wait 8",
        "#shot thunder",
        "weather clear",
        "#wait 12",
        "#client quicksilver speed option.look pixel-art",
        "#wait 4",
        "#shot pixel",
        "#client quicksilver speed option.look normal",
        "#wait 2",
        "#client quicksilver speed option.dynamic-lights 1",
        "#wait 2",
        "#shot lights",
        "#client quicksilver speed option.dynamic-lights off",
        "#far off"
      ],
      "ciViewNote": "package 12b: looking north-west (yaw 135), not east: from the east view a 100-block real cliff stood inside the hand-over band, so the seam check compared the island's top just beyond the band with the ocean just nearer it (a step of about 120 in those columns with no hole at all); of seven other directions shot in run 45939071469, north-west keeps real terrain, ocean and mountains in view and its band crosses no cliff (docs/ci-limits.md, Package 12b)",
      "ciConditionsNote": "package 12c: the same view at sunset, night, in rain and thunder, with pixel art and with dynamic lights (far terrain follows the sky light, the fog's colour and the weather like real terrain)"
    },
